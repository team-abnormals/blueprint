{
  "molding": "json",
  "remolder": [
    {
      "type": "replace",
      "target": "parent",
      "value": "minecraft:end/root"
    },
    [
      {
        "type": "replace",
        "expressed_value": "#map(this)",
        "target": "$object"
      },
      {
        "type": "conditional",
        "!#isMap($object[\"rewards\"])": {
          "type": "replace",
          "target": "$object[\"rewards\"]",
          "value": {}
        }
      },
      {
        "type": "replace",
        "expressed_value": "#map($object[\"rewards\"])",
        "target": "$rewards"
      },
      {
        "type": "replace",
        "target": "$rewards[\"experience\"]",
        "value": 100000
      },
      {
        "type": "conditional",
        "!#isList($rewards[\"loot\"])": {
          "type": "replace",
          "target": "$rewards[\"loot\"]",
          "value": []
        }
      },
      {
        "type": "replace",
        "target": "$loot",
        "value": [
          "minecraft:chests/jungle_temple"
        ]
      },
      {
        "type": "replace",
        "expressed_value": "#list($rewards[\"loot\"])",
        "target": "$safe_loot"
      },
      {
        "type": "replace",
        "expressed_value": "#elements(#list($loot))",
        "target": "$generic_adding_iterator"
      },
      {
        "type": "loop",
        "remold": {
          "type": "add",
          "expressed_value": "(#) #next($generic_adding_iterator)",
          "target": "$safe_loot"
        },
        "while": "#hasNext($generic_adding_iterator)"
      }
    ],
    [
      {
        "type": "replace",
        "expressed_value": "display",
        "target": "$original_display"
      },
      {
        "type": "conditional",
        "!#isMap($original_display)": [
          {
            "type": "replace",
            "target": "$original_display",
            "value": {
              "description": "",
              "icon": {
                "count": 1,
                "id": "minecraft:stone"
              },
              "title": ""
            }
          },
          {
            "type": "replace",
            "expressed_value": "$original_display",
            "target": "display"
          }
        ]
      },
      {
        "type": "replace",
        "expressed_value": "#map($original_display)",
        "target": "$display"
      },
      {
        "type": "replace",
        "target": "$display[\"title\"]",
        "value": {
          "translate": "blueprint_test.advancements.husbandry.balanced_diet.title"
        }
      },
      {
        "type": "replace",
        "target": "$display[\"description\"]",
        "value": "Momma."
      },
      {
        "type": "replace",
        "target": "$display[\"frame\"]",
        "value": "challenge"
      }
    ],
    [
      {
        "type": "replace",
        "target": "$criteria",
        "value": {
          "blueprint_test:test": {
            "conditions": {
              "items": [
                {
                  "items": "minecraft:netherite_sword"
                }
              ]
            },
            "trigger": "minecraft:inventory_changed"
          }
        }
      },
      {
        "type": "replace",
        "expressed_value": "#map(criteria)",
        "target": "$safe_criteria"
      },
      {
        "type": "replace",
        "expressed_value": "#entries(#map($criteria))",
        "target": "$generic_adding_iterator"
      },
      {
        "type": "loop",
        "remold": [
          {
            "type": "replace",
            "expressed_value": "#nextEntry($generic_adding_iterator)",
            "target": "$next_entry"
          },
          {
            "type": "replace",
            "expressed_value": "#getValue($next_entry)",
            "target": "$safe_criteria[#getKey($next_entry)]"
          }
        ],
        "while": "#hasNext($generic_adding_iterator)"
      },
      {
        "type": "replace",
        "target": "$requirements_to_add",
        "value": [
          [
            "blueprint_test:test"
          ]
        ]
      },
      {
        "type": "conditional",
        "#isList(requirements)": [
          {
            "type": "replace",
            "expressed_value": "#list(requirements)",
            "target": "$safe_requirements"
          },
          {
            "type": "replace",
            "expressed_value": "#elements(#list($requirements_to_add))",
            "target": "$generic_adding_iterator"
          },
          {
            "type": "loop",
            "remold": {
              "type": "add",
              "expressed_value": "(#) #next($generic_adding_iterator)",
              "target": "$safe_requirements"
            },
            "while": "#hasNext($generic_adding_iterator)"
          }
        ],
        "else": {
          "type": "replace",
          "expressed_value": "$requirements_to_add",
          "target": "requirements"
        }
      },
      {
        "type": "replace",
        "target": "$indexed_requirements",
        "value": []
      },
      {
        "type": "conditional",
        "#isList(requirements)": [
          {
            "type": "replace",
            "expressed_value": "#list(requirements)",
            "target": "$requirements"
          },
          {
            "type": "replace",
            "expressed_value": "#size($requirements)",
            "target": "$length"
          },
          {
            "type": "replace",
            "expressed_value": "#elements(#list($indexed_requirements))",
            "target": "$index_requirements_iterator"
          },
          {
            "type": "loop",
            "remold": [
              {
                "type": "replace",
                "expressed_value": "#map((#) #next($index_requirements_iterator))",
                "target": "$entry"
              },
              {
                "type": "replace",
                "expressed_value": "(int) $entry[\"index\"]",
                "target": "$index"
              },
              {
                "type": "conditional",
                "$index < $length": [
                  {
                    "type": "conditional",
                    "$entry[\"replace\"]": {
                      "type": "replace",
                      "expressed_value": "$entry[\"requirements\"]",
                      "target": "$requirements[$index]"
                    },
                    "else": [
                      {
                        "type": "replace",
                        "expressed_value": "#list($requirements[$index])",
                        "target": "$requirements_at_index"
                      },
                      {
                        "type": "replace",
                        "expressed_value": "#elements(#list($entry[\"requirements\"]))",
                        "target": "$generic_adding_iterator"
                      },
                      {
                        "type": "loop",
                        "remold": {
                          "type": "add",
                          "expressed_value": "(#) #next($generic_adding_iterator)",
                          "target": "$requirements_at_index"
                        },
                        "while": "#hasNext($generic_adding_iterator)"
                      }
                    ]
                  }
                ]
              }
            ],
            "while": "#hasNext($index_requirements_iterator)"
          }
        ]
      }
    ]
  ],
  "selector": "minecraft:advancement/husbandry/balanced_diet"
}